<?xml version="1.0" encoding="UTF-8"?>
<plugin
    id="vpmcp.create"
    name="Visual Paradigm MCP Create Server"
    description="Creates and edits diagrams in the open Visual Paradigm project over the Model Context Protocol."
    provider="vpmcp"
    class="vpmcp.create.VpCreatePlugin">
  <runtime>
    <library path="lib/vpmcp.create.jar" relativePath="true"/>
  </runtime>
  <actionSets>
    <actionSet id="vpmcp.create.actionset">
      <action
          id="vpmcp.create.actions.status"
          actionType="generalAction"
          label="MCP Create Server"
          tooltip="Show whether the MCP Create server is running, and at what address"
          style="normal"
          icon="icons/mcp-create.png"
          menuPath="Tools/MCP Create Server"
          ribbonPath="Tools/MCP Create Server">
        <actionController class="vpmcp.create.ui.StatusActionController"/>
      </action>
    </actionSet>
  </actionSets>
</plugin>
